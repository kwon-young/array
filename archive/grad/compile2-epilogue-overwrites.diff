+% overwrites(+Eq): the equation writes a name its value does not read: its register tile
+% needs no copy in. One that reads its target, Y[Ts] := Y[Ts] + C[Ts], loads it at each tile.
+overwrites(P := V) :-
+   core2:place(P, N, _),
+   names(V, Ns),
+   \+ in_list(Ns, N).
+
